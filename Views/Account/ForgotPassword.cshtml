@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password — HealthSpark</title>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-body">

    <div class="auth-panel">

        <div class="auth-brand">
            <div class="auth-brand-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                </svg>
            </div>
            <div class="auth-brand-name">HealthSpark</div>
        </div>

        <div class="auth-card-header">
            <div class="auth-title">Reset your password</div>
            <div class="auth-sub">
                Enter your email address and we'll send you a link to reset your password.
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="display:flex;align-items:flex-start;gap:12px;padding:16px;
                            background:var(--stable-bg);border:1px solid var(--stable-border);
                            border-radius:var(--radius-md);margin-bottom:20px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"
                     style="color:var(--stable);flex-shrink:0;margin-top:1px;">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
                <div>
                    <div style="font-size:14px;font-weight:600;color:var(--stable);margin-bottom:4px;">
                        Reset email sent
                    </div>
                    <div style="font-size:13px;color:var(--slate-mid);line-height:1.5;">
                        @TempData["SuccessMessage"]
                    </div>
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="auth-error" style="margin-bottom:20px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="ForgotPassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group" style="margin-bottom:20px;">
                <label class="form-label">Email Address</label>
                <input name="email"
                       class="form-input"
                       type="email"
                       placeholder="you@example.com"
                       autocomplete="email"
                       required />
            </div>

            <button type="submit" class="btn btn-primary btn-full"
                    style="padding:12px 18px;font-size:14px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                </svg>
                Send Reset Link
            </button>

        </form>

        <div class="auth-footer">
            <a href="@Url.Action("Login", "Account")"
               style="display:inline-flex;align-items:center;gap:6px;color:var(--forest);font-weight:600;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12" />
                    <polyline points="12 19 5 12 12 5" />
                </svg>
                Back to Sign In
            </a>
        </div>

    </div>

    <!-- Right panel — same hero as login -->
    <div class="auth-hero">
        <div class="auth-hero-pill">
            <span class="auth-hero-pill-dot"></span>
            System Online &middot; South Africa
        </div>
        <img src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=1200&q=80"
             alt="Doctor using digital health platform"
             loading="eager" />
        <div class="auth-hero-text">
            <div class="auth-hero-quote">
                "Your health data is always safe,<br />secure, and in your hands."
            </div>
            <div class="auth-hero-caption">
                POPIA compliant &middot; Encrypted &middot; Built for South Africa
            </div>
        </div>
    </div>

</body>
</html>