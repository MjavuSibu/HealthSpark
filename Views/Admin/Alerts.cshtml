@model HealthSpark.ViewModels.DashboardViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "System Alerts";
    ViewData["ActivePage"] = "Alerts";
    ViewData["Sidebar"] = "_AdminSidebar";
}

<!-- Summary KPIs -->
<div class="kpi-strip" style="grid-template-columns:repeat(3,1fr);margin-bottom:24px;">

    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-caution">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.Alerts.Count</div>
            <div class="kpi-label">Unresolved Alerts</div>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-forest">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">
                @Model.Alerts.Count(a => a.CreatedAt.Date == DateTime.UtcNow.Date)
            </div>
            <div class="kpi-label">New Today</div>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-stable">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">0</div>
            <div class="kpi-label">Resolved Today</div>
        </div>
    </div>

</div>

<!-- Alerts List -->
<div class="card">
    <div class="card-header">
        <div class="card-title">All Active Alerts</div>
        @if (Model.Alerts.Any())
        {
            <span class="badge badge-high">@Model.Alerts.Count unresolved</span>
        }
    </div>
    <div class="card-body">
        @if (!Model.Alerts.Any())
        {
            <div class="empty-state" style="padding:40px 0;">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.5"
                     stroke-linecap="round" stroke-linejoin="round"
                     style="margin:0 auto 12px;display:block;color:var(--border);">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
                No active alerts. Everything looks healthy.
            </div>
        }
        else
        {
            foreach (var alert in Model.Alerts)
            {
                var alertAge = DateTime.UtcNow - alert.CreatedAt;
                var alertAgeText = alertAge.TotalHours < 1
                ? $"{(int)alertAge.TotalMinutes}m ago"
                : alertAge.TotalHours < 24
                ? $"{(int)alertAge.TotalHours}h ago"
                : $"{(int)alertAge.TotalDays}d ago";

                <div class="alert-row">
                    <div class="alert-icon">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                            <line x1="12" y1="9" x2="12" y2="13" />
                            <line x1="12" y1="17" x2="12.01" y2="17" />
                        </svg>
                    </div>
                    <div class="alert-body">
                        <div class="alert-name">@alert.Message</div>
                        <div class="alert-desc">
                            Patient: @alert.PatientId.Substring(0, Math.Min(8, alert.PatientId.Length))... &middot; @alertAgeText
                        </div>
                    </div>
                    <div style="text-align:right;flex-shrink:0;">
                        <form asp-action="ResolveAlert" asp-controller="Admin" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="alertId" value="@alert.Id" />
                            <button type="submit" class="btn btn-ghost btn-sm">Resolve</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>