@model HealthSpark.ViewModels.DashboardViewModel
@using System.Linq
@using System.Text.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    ViewData["Sidebar"] = "_AdminSidebar";
    ViewData["AlertCount"] = Model.Alerts.Count;

    // ── Time-aware greeting (cross-platform safe) ──────
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    var adminName = ViewData["CurrentUserName"]?.ToString() ?? "Admin";
    ViewData["CurrentUserName"] = adminName;

    // ── System health percentage ───────────────────────
    var totalPatients = Model.TotalPatients;
    var unassignedCount = Model.UnassignedPatients.Count;
    var assignedCount = totalPatients - unassignedCount;
    var healthPct = totalPatients > 0 ? (int)((assignedCount / (double)totalPatients) * 100) : 100;

    // ── Doctor workload data for chart ─────────────────
    var workloadLabels = Model.AllDoctors.Take(6).Select(d => d.FullName.Split(' ')[0]).ToList();
    var workloadData = Model.AllDoctors.Take(6).Select(d => 0).ToList(); // placeholder — real data needs DoctorProfile counts
}

<!-- ── Welcome Banner ──────────────────────────────────── -->
<div class="welcome-banner">
    <div class="welcome-title">@greeting, @adminName.Split(' ')[0]</div>
    <div class="welcome-sub">Here's what's happening across the system today.</div>
    <div class="welcome-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
</div>

<!-- ── KPI Strip ───────────────────────────────────────── -->
<div class="kpi-strip">

    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-forest">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6
                         6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3" />
                <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4" />
                <circle cx="20" cy="10" r="2" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.TotalDoctors</div>
            <div class="kpi-label">Total Doctors</div>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-gold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.TotalPatients</div>
            <div class="kpi-label">Total Patients</div>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-stable">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.TotalAppointmentsToday</div>
            <div class="kpi-label">Confirmed Today</div>
        </div>
    </div>

    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-caution">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94
                         a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@Model.TotalFlaggedReadings</div>
            <div class="kpi-label">Active Alerts</div>
        </div>
    </div>

</div>

<!-- ── System Health Bar ───────────────────────────────── -->
<div class="card" style="margin-bottom:22px;">
    <div class="card-body" style="padding:18px 24px;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
            <div>
                <div style="font-size:13px;font-weight:600;color:var(--slate);">
                    Patient Assignment Coverage
                </div>
                <div style="font-size:12px;color:var(--slate-soft);margin-top:2px;">
                    @assignedCount of @totalPatients patients assigned to a doctor
                </div>
            </div>
            <div style="font-family:'Cormorant Garamond',serif;font-size:26px;
                        font-weight:700;color:@(healthPct >= 90 ? "var(--stable)" : healthPct >= 70 ? "var(--caution)" : "var(--critical)");">
                @healthPct%
            </div>
        </div>
        <div class="progress-track" style="height:8px;">
            <div class="progress-fill"
                 style="width:@healthPct%;
                        background:@(healthPct >= 90
                                             ? "linear-gradient(90deg,var(--forest-light),var(--forest))"
                                             : healthPct >= 70
                                             ? "linear-gradient(90deg,#E8A230,var(--caution))"
                                             : "linear-gradient(90deg,#E05050,var(--critical))");">
            </div>
        </div>
        @if (unassignedCount > 0)
        {
            <div style="margin-top:10px;display:flex;align-items:center;gap:8px;">
                <span class="badge badge-pending">@unassignedCount unassigned</span>
                <a href="@Url.Action("Assignments", "Admin")"
                   style="font-size:12px;color:var(--forest);font-weight:600;">
                    Go to Assignments
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round"
                         style="margin-left:2px;">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </a>
            </div>
        }
    </div>
</div>

<!-- ── Main Grid: Alerts + Unassigned | Doctors + Chart ── -->
<div class="grid-2" style="margin-bottom:22px;">

    <!-- LEFT: System Alerts -->
    <div class="card" style="margin-bottom:0;">
        <div class="card-header">
            <div class="card-title">System Alerts</div>
            <div style="display:flex;align-items:center;gap:8px;">
                @if (Model.Alerts.Any())
                {
                    <span class="badge badge-high">@Model.Alerts.Count active</span>
                }
                <a href="@Url.Action("Alerts", "Admin")" class="btn btn-ghost btn-sm">
                    View all
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Alerts.Any())
            {
                <div class="empty-state" style="padding:24px 0;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round"
                         style="margin:0 auto 10px;display:block;color:var(--border);">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    No active alerts. System is healthy.
                </div>
            }
            else
            {
                foreach (var alert in Model.Alerts.Take(5))
                {
                    var alertAge = DateTime.UtcNow - alert.CreatedAt;
                    var alertAgeText = alertAge.TotalHours < 1
                    ? $"{(int)alertAge.TotalMinutes}m ago"
                    : alertAge.TotalHours < 24
                    ? $"{(int)alertAge.TotalHours}h ago"
                    : $"{(int)alertAge.TotalDays}d ago";

                    <div class="alert-row">
                        <div class="alert-icon">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94
                                                 a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                                <line x1="12" y1="9" x2="12" y2="13" />
                                <line x1="12" y1="17" x2="12.01" y2="17" />
                            </svg>
                        </div>
                        <div class="alert-body">
                            <div class="alert-name">@alert.Message</div>
                            <div class="alert-desc">@alertAgeText</div>
                        </div>
                        <form asp-action="ResolveAlert" asp-controller="Admin"
                              method="post" style="flex-shrink:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="alertId" value="@alert.Id" />
                            <button type="submit" class="btn btn-ghost btn-sm">
                                Resolve
                            </button>
                        </form>
                    </div>
                }
            }
        </div>
    </div>

    <!-- RIGHT: Unassigned Patients -->
    <div class="card" style="margin-bottom:0;">
        <div class="card-header">
            <div class="card-title">Unassigned Patients</div>
            @if (Model.UnassignedPatients.Any())
            {
                <span class="badge badge-pending">@Model.UnassignedPatients.Count pending</span>
            }
        </div>
        <div class="card-body">
            @if (!Model.UnassignedPatients.Any())
            {
                <div class="empty-state" style="padding:24px 0;">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round"
                         style="margin:0 auto 10px;display:block;color:var(--border);">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                    </svg>
                    All patients are assigned.
                </div>
            }
            else
            {
                foreach (var patient in Model.UnassignedPatients.Take(5))
                {
                    var initials = patient.FullName.Length >= 2
                    ? patient.FullName[..2].ToUpper()
                    : patient.FullName.ToUpper();

                    <div class="activity-item">
                        <div class="avatar av-2">@initials</div>
                        <div style="flex:1;min-width:0;">
                            <div class="user-name" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @patient.FullName
                            </div>
                            <div class="user-email" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                @patient.Email
                            </div>
                        </div>
                        <a href="@Url.Action("Assignments", "Admin")"
                           class="btn btn-primary btn-sm" style="flex-shrink:0;">
                            Assign
                        </a>
                    </div>
                }
                if (Model.UnassignedPatients.Count > 5)
                {
                    <div style="text-align:center;padding-top:12px;
                                        border-top:1px solid var(--border-soft);margin-top:8px;">
                        <a href="@Url.Action("Assignments", "Admin")"
                           style="font-size:12.5px;color:var(--forest);font-weight:600;">
                            +@(Model.UnassignedPatients.Count - 5) more — view all assignments
                        </a>
                    </div>
                }
            }
        </div>
    </div>

</div>

<!-- ── Bottom Grid: Doctor list + Patient list ─────────── -->
<div class="grid-2">

    <!-- Doctors table -->
    <div class="card" style="margin-bottom:0;">
        <div class="card-header">
            <div class="card-title">Doctors</div>
            <a href="@Url.Action("Doctors", "Admin")" class="btn btn-ghost btn-sm">
                View all
            </a>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Doctor</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.AllDoctors.Any())
                    {
                        <tr>
                            <td colspan="2">
                                <div class="empty-state" style="padding:20px 0;">
                                    No doctors registered yet.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var doctor in Model.AllDoctors.Take(6))
                        {
                            var initials = doctor.FullName.Length >= 2
                            ? doctor.FullName[..2].ToUpper()
                            : doctor.FullName.ToUpper();
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="avatar av-1">@initials</div>
                                        <div>
                                            <div class="user-name">@doctor.FullName</div>
                                            <div class="user-email">@doctor.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(doctor.IsActive ? "badge-active" : "badge-inactive")">
                                        @(doctor.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent patients table -->
    <div class="card" style="margin-bottom:0;">
        <div class="card-header">
            <div class="card-title">Recent Patients</div>
            <a href="@Url.Action("Patients", "Admin")" class="btn btn-ghost btn-sm">
                View all
            </a>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.AllPatients.Any())
                    {
                        <tr>
                            <td colspan="2">
                                <div class="empty-state" style="padding:20px 0;">
                                    No patients registered yet.
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var patient in Model.AllPatients.Take(6))
                        {
                            var initials = patient.FullName.Length >= 2
                            ? patient.FullName[..2].ToUpper()
                            : patient.FullName.ToUpper();
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="avatar av-2">@initials</div>
                                        <div>
                                            <div class="user-name">@patient.FullName</div>
                                            <div class="user-email">@patient.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(patient.IsActive ? "badge-active" : "badge-inactive")">
                                        @(patient.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // ── Animate progress bar on load ───────────────────
        document.addEventListener('DOMContentLoaded', () => {
            const fill = document.querySelector('.progress-fill');
            if (fill) {
                const target = fill.style.width;
                fill.style.width = '0%';
                setTimeout(() => { fill.style.width = target; }, 100);
            }
        });
    </script>
}