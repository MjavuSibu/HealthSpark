@model HealthSpark.ViewModels.DashboardViewModel
@using System.Linq

@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    ViewData["Sidebar"] = "_DoctorSidebar";
    ViewData["CurrentUserName"] = Model.CurrentUser.FullName;
    ViewData["DoctorSpecialisation"] = Model.DoctorProfile?.Specialisation ?? "General Practice";
    ViewData["AlertCount"] = Model.UnreadAlertsCount;

    // ── Time-aware greeting (cross-platform safe) ──────
    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    var firstName = Model.CurrentUser.FullName.Split(' ')[0];
    var specialisation = Model.DoctorProfile?.Specialisation ?? "General Practice";

    // ── Welcome sub-line ───────────────────────────────
    var apptCount = Model.TodaysAppointments.Count;
    var alertCount = Model.UnreadAlertsCount;
    var patientCount = Model.AssignedPatients.Count;

    var subLine = apptCount > 0
        ? $"You have {apptCount} appointment{(apptCount == 1 ? "" : "s")} today" +
          (alertCount > 0 ? $" and {alertCount} unread alert{(alertCount == 1 ? "" : "s")}." : ".")
        : alertCount > 0
            ? $"No appointments today, but you have {alertCount} unread alert{(alertCount == 1 ? "" : "s")}."
            : "No appointments or alerts today. Your schedule is clear.";
}

<!-- ── Welcome Banner ──────────────────────────────────── -->
<div class="welcome-banner">
    <div class="welcome-title">@greeting, Dr. @firstName</div>
    <div class="welcome-sub">@subLine</div>
    <div class="welcome-date">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</div>
</div>

<!-- ── KPI Strip ───────────────────────────────────────── -->
<div class="kpi-strip">

    <!-- Assigned Patients -->
    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-forest">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@patientCount</div>
            <div class="kpi-label">Assigned Patients</div>
        </div>
    </div>

    <!-- Today's Appointments -->
    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-gold">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@apptCount</div>
            <div class="kpi-label">Appointments Today</div>
        </div>
    </div>

    <!-- Unread Alerts -->
    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-caution">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value">@alertCount</div>
            <div class="kpi-label">Unread Alerts</div>
        </div>
    </div>

    <!-- Specialisation badge -->
    <div class="kpi-card">
        <div class="kpi-icon-wrap ki-stable">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6
                         6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3" />
                <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4" />
                <circle cx="20" cy="10" r="2" />
            </svg>
        </div>
        <div class="kpi-body">
            <div class="kpi-value" style="font-size:16px;line-height:1.2;margin-top:2px;">
                @specialisation
            </div>
            <div class="kpi-label">Specialisation</div>
        </div>
    </div>

</div>

<!-- ── Main Grid ───────────────────────────────────────── -->
<div class="grid-3" style="margin-bottom:22px;">

    <!-- LEFT (2fr): Today's appointments -->
    <div class="card" style="margin-bottom:0;">
        <div class="card-header">
            <div class="card-title">Today's Appointments</div>
            <a href="@Url.Action("Appointments", "Doctor")"
               class="btn btn-ghost btn-sm">View all</a>
        </div>
        <div class="card-body">
            @if (!Model.TodaysAppointments.Any())
            {
                <div class="empty-state" style="padding:32px 0;">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round"
                         style="margin:0 auto 12px;display:block;color:var(--border);">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                    No appointments scheduled for today.
                </div>
            }
            else
            {
                foreach (var appt in Model.TodaysAppointments)
                {
                    var timeParts = appt.TimeSlot.Split(' ');
                    var timeNum = timeParts.Length > 0 ? timeParts[0] : appt.TimeSlot;
                    var timeAmPm = timeParts.Length > 1 ? timeParts[1] : "";

                    <div class="appt-item">
                        <!-- Time block -->
                        <div style="text-align:center;width:52px;flex-shrink:0;">
                            <div style="font-family:'Cormorant Garamond',serif;
                                                font-size:20px;font-weight:700;
                                                color:var(--forest);line-height:1;">
                                @timeNum
                            </div>
                            <div style="font-size:9px;color:var(--slate-muted);
                                                text-transform:uppercase;letter-spacing:1px;">
                                @timeAmPm
                            </div>
                        </div>

                        <div class="appt-divider"></div>

                        <!-- Patient + reason -->
                        <div class="appt-patient">
                            <div class="appt-name">
                                <!-- PatientId shown since names need a separate lookup -->
                                Patient @appt.PatientId.Substring(0, Math.Min(8, appt.PatientId.Length))...
                            </div>
                            <div class="appt-reason">@appt.Reason</div>
                        </div>

                        <span class="badge @(appt.Status == "confirmed" ? "badge-active" : "badge-pending")">
                            @appt.Status
                        </span>
                    </div>
                }
            }
        </div>
    </div>

    <!-- RIGHT (1fr): Alerts feed -->
    <div style="display:flex;flex-direction:column;gap:18px;">

        <div class="card" style="margin-bottom:0;">
            <div class="card-header">
                <div class="card-title">Flagged Readings</div>
                @if (Model.Alerts.Any())
                {
                    <span class="badge badge-high">@Model.Alerts.Count</span>
                }
            </div>
            <div class="card-body">
                @if (!Model.Alerts.Any())
                {
                    <div class="empty-state" style="padding:24px 0;">
                        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="1.5"
                             stroke-linecap="round" stroke-linejoin="round"
                             style="margin:0 auto 10px;display:block;color:var(--border);">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                            <polyline points="22 4 12 14.01 9 11.01" />
                        </svg>
                        No flagged readings.
                    </div>
                }
                else
                {
                    foreach (var alert in Model.Alerts.Take(4))
                    {
                        var alertAge = DateTime.UtcNow - alert.CreatedAt;
                        var alertAgeText = alertAge.TotalHours < 1
                        ? $"{(int)alertAge.TotalMinutes}m ago"
                        : alertAge.TotalHours < 24
                        ? $"{(int)alertAge.TotalHours}h ago"
                        : $"{(int)alertAge.TotalDays}d ago";

                        <div class="alert-row">
                            <div class="alert-icon">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94
                                                     a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                                    <line x1="12" y1="9" x2="12" y2="13" />
                                    <line x1="12" y1="17" x2="12.01" y2="17" />
                                </svg>
                            </div>
                            <div class="alert-body">
                                <div class="alert-name">@alert.Message</div>
                                <div class="alert-desc">@alertAgeText</div>
                            </div>
                            <a href="@Url.Action("PatientDetail", "Doctor", new { patientId = alert.PatientId })"
                               class="btn btn-ghost btn-sm" style="flex-shrink:0;">
                                View
                            </a>
                        </div>
                    }

                    if (Model.Alerts.Count > 4)
                    {
                        <div style="text-align:center;padding-top:10px;
                                            border-top:1px solid var(--border-soft);margin-top:6px;">
                            <a href="@Url.Action("Alerts", "Doctor")"
                               style="font-size:12.5px;color:var(--forest);font-weight:600;">
                                +@(Model.Alerts.Count - 4) more alerts
                            </a>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Quick actions -->
        <div class="card" style="margin-bottom:0;">
            <div class="card-header">
                <div class="card-title">Quick Actions</div>
            </div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:8px;">
                <a href="@Url.Action("Patients", "Doctor")"
                   class="btn btn-ghost btn-full"
                   style="justify-content:flex-start;gap:10px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                    </svg>
                    View All Patients
                </a>
                <a href="@Url.Action("Appointments", "Doctor")"
                   class="btn btn-ghost btn-full"
                   style="justify-content:flex-start;gap:10px;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                        <line x1="16" y1="2" x2="16" y2="6" />
                        <line x1="8" y1="2" x2="8" y2="6" />
                        <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                    Manage Appointments
                </a>
                <a href="@Url.Action("Alerts", "Doctor")"
                   class="btn btn-full"
                   style="justify-content:flex-start;gap:10px;
                          background:@(alertCount > 0 ? "var(--critical-bg)" : "var(--stone)");
                          color:@(alertCount > 0 ? "var(--critical)" : "var(--slate-mid)");
                          border:1px solid @(alertCount > 0 ? "var(--critical-border)" : "var(--border-soft)");">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                        <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                    </svg>
                    @(alertCount > 0 ? $"{alertCount} Unread Alert{(alertCount == 1 ? "" : "s")}" : "Alerts — Clear")
                </a>
            </div>
        </div>

    </div>
</div>

<!-- ── Assigned Patients Table ─────────────────────────── -->
<div class="card">
    <div class="card-header">
        <div class="card-title">My Patients</div>
        <a href="@Url.Action("Patients", "Doctor")" class="btn btn-ghost btn-sm">
            View all
        </a>
    </div>
    @if (!Model.AssignedPatients.Any())
    {
        <div class="empty-state" style="padding:36px 0;">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round"
                 style="margin:0 auto 12px;display:block;color:var(--border);">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
            </svg>
            No patients assigned yet. Contact your admin.
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Gender</th>
                        <th>Date of Birth</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var patient in Model.AssignedPatients.Take(6))
                    {
                        var initials = patient.FullName.Length >= 2
                        ? patient.FullName[..2].ToUpper()
                        : patient.FullName.ToUpper();

                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="avatar av-1">@initials</div>
                                    <div>
                                        <div class="user-name">@patient.FullName</div>
                                        <div class="user-email">@patient.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td style="color:var(--slate-soft);font-size:13px;">
                                @(string.IsNullOrEmpty(patient.Gender) ? "—" : patient.Gender)
                            </td>
                            <td style="color:var(--slate-soft);font-size:13px;">
                                @(string.IsNullOrEmpty(patient.DateOfBirth) ? "—" : patient.DateOfBirth)
                            </td>
                            <td>
                                <span class="badge @(patient.IsActive ? "badge-active" : "badge-inactive")">
                                    @(patient.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("PatientDetail", "Doctor", new { patientId = patient.Id })"
                                   class="tbl-btn tbl-btn-view">
                                    <svg width="13" height="13"><use href="#ic-eye" /></svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>