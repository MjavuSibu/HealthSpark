@model HealthSpark.ViewModels.DashboardViewModel
@using System.Linq

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.CurrentUser.FullName;
    ViewData["ActivePage"] = "Patients";
    ViewData["Sidebar"] = "_DoctorSidebar";
    ViewData["CurrentUserName"] = Model.CurrentUser?.FullName ?? "Doctor";
    ViewData["DoctorSpecialisation"] = Model.DoctorProfile?.Specialisation ?? "Doctor";
    ViewData["AlertCount"] = Model.UnreadAlertsCount;

    var notes = ViewBag.Notes as List<HealthSpark.Models.ClinicalNote>
                ?? new List<HealthSpark.Models.ClinicalNote>();

    // ── Inline risk score for this patient ────────────
    int riskScore = 0;
    var v = Model.LatestVital;
    if (v != null)
    {
        if (v.BloodPressureSystolic > 180) riskScore += 30;
        else if (v.BloodPressureSystolic > 140) riskScore += 20;
        else if (v.BloodPressureSystolic > 130) riskScore += 10;
        if (v.HeartRate > 120) riskScore += 20;
        else if (v.HeartRate > 100) riskScore += 12;
        else if (v.HeartRate < 60 && v.HeartRate > 0) riskScore += 10;
        if (v.BloodGlucose > 14) riskScore += 20;
        else if (v.BloodGlucose > 11) riskScore += 12;
        else if (v.BloodGlucose > 8) riskScore += 6;
        if (v.Temperature > 39.5) riskScore += 15;
        else if (v.Temperature > 38) riskScore += 8;
        if (v.SleepHours < 5 && v.SleepHours > 0) riskScore += 8;
        else if (v.SleepHours < 7 && v.SleepHours > 0) riskScore += 4;
    }
    riskScore = Math.Min(riskScore, 100);
    var riskBand = riskScore >= 60 ? "Critical" : riskScore >= 35 ? "Moderate" : riskScore >= 15 ? "Low Risk" : "Stable";
    var riskClass = riskScore >= 60 ? "risk--critical" : riskScore >= 35 ? "risk--moderate" : "risk--stable";

    var bpClass = v == null ? "vital-card--nodata" : v.BloodPressureSystolic > 140 ? "vital-card--critical" : v.BloodPressureSystolic > 130 ? "vital-card--caution" : "vital-card--normal";
    var hrClass = v == null ? "vital-card--nodata" : (v.HeartRate > 100 || (v.HeartRate < 60 && v.HeartRate > 0)) ? "vital-card--critical" : "vital-card--normal";
    var glcClass = v == null ? "vital-card--nodata" : v.BloodGlucose > 11 ? "vital-card--critical" : v.BloodGlucose > 8 ? "vital-card--caution" : "vital-card--normal";
    var tmpClass = v == null ? "vital-card--nodata" : v.Temperature > 39.5 ? "vital-card--critical" : v.Temperature > 38 ? "vital-card--caution" : "vital-card--normal";
}

<!-- Back Button -->
<a href="@Url.Action("Patients", "Doctor")" class="back-btn">
    <svg width="14" height="14"><use href="#ic-arrow-left" /></svg>
    Back to Patients
</a>

<!-- Patient Header -->
<div class="patient-header">
    <div class="patient-avatar-lg av-5">
        @Model.CurrentUser.FullName[..2].ToUpper()
    </div>
    <div class="patient-meta">
        <div class="patient-full-name">@Model.CurrentUser.FullName</div>
        <div class="patient-details">
            @Model.CurrentUser.Email &middot;
            @(string.IsNullOrEmpty(Model.CurrentUser.Gender) ? "—" : Model.CurrentUser.Gender) &middot;
            DOB: @(string.IsNullOrEmpty(Model.CurrentUser.DateOfBirth) ? "—" : Model.CurrentUser.DateOfBirth)
        </div>
        <div class="patient-tags">
            @if (Model.PatientProfile != null)
            {
                if (!string.IsNullOrEmpty(Model.PatientProfile.BloodType))
                {
                    <span class="patient-tag">Blood Type: @Model.PatientProfile.BloodType</span>
                }
                foreach (var condition in Model.PatientProfile.ExistingConditions)
                {
                    <span class="patient-tag">@condition</span>
                }
                foreach (var allergy in Model.PatientProfile.Allergies)
                {
                    <span class="patient-tag"
                          style="background:var(--critical-bg);
                                         color:var(--critical);
                                         border-color:var(--critical-border);">
                        @allergy Allergy
                    </span>
                }
            }
        </div>
    </div>

    <!-- Risk score pill + actions -->
    <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px;flex-shrink:0;">
        @if (v != null)
        {
            <div style="text-align:center;padding:10px 18px;
                            background:var(--stone);border:1px solid var(--border-soft);
                            border-radius:var(--radius-md);">
                <div style="font-size:10px;font-weight:700;letter-spacing:1.2px;
                                 text-transform:uppercase;color:var(--slate-muted);margin-bottom:3px;">
                    Risk Score
                </div>
                <div style="font-family:'Cormorant Garamond',serif;font-size:28px;
                                 font-weight:700;line-height:1;
                                 color:@(riskScore >= 60 ? "var(--critical)" : riskScore >= 35 ? "var(--caution)" : "var(--stable)");">
                    @riskScore
                </div>
                <div style="font-size:11px;font-weight:600;
                                 color:@(riskScore >= 60 ? "var(--critical)" : riskScore >= 35 ? "var(--caution)" : "var(--stable)");">
                    @riskBand
                </div>
            </div>
        }
        <button class="btn btn-primary btn-sm" onclick="openModal('addNoteModal')">
            <svg width="13" height="13"><use href="#ic-note" /></svg> Add Note
        </button>
    </div>
</div>

<!-- Tabs -->
<div class="tabs">
    <button class="tab active" onclick="showTab('vitals', this)">Vitals</button>
    <button class="tab" onclick="showTab('symptoms', this)">Symptoms &amp; AI</button>
    <button class="tab" onclick="showTab('notes', this)">
        Clinical Notes
        @if (notes.Any(n => n.IsAlert))
        {
            <span style="display:inline-flex;align-items:center;justify-content:center;
                             width:16px;height:16px;background:var(--critical);
                             color:white;border-radius:50%;font-size:9px;
                             font-weight:700;margin-left:5px;">
                @notes.Count(n => n.IsAlert)
            </span>
        }
    </button>
    <button class="tab" onclick="showTab('appointments', this)">Appointments</button>
</div>

<!-- ── VITALS TAB ───────────────────────────────────────── -->
<div class="tab-panel active" id="tab-vitals">
    @if (v != null)
    {
        <div class="vitals-grid" style="margin-bottom:22px;">

            <div class="vital-card @bpClass">
                <div class="vital-label">Blood Pressure</div>
                <div class="vital-value" style="font-size:22px;">
                    @v.BloodPressureSystolic<span style="font-size:16px;font-weight:400;color:var(--slate-soft);">/@v.BloodPressureDiastolic</span>
                </div>
                <div class="vital-unit">mmHg</div>
                @if (v.BloodPressureSystolic > 140)
                {
                    <span class="vital-flag"><svg width="10" height="10"><use href="#ic-alert" /></svg> High</span>
                }
                else if (v.BloodPressureSystolic > 130)
                {

                    <span class="vital-warn">Elevated</span>
                }
                else
                {

                    <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle" /></svg> Normal</span>
                }
            </div>

            <div class="vital-card @hrClass">
                <div class="vital-label">Heart Rate</div>
                <div class="vital-value">@v.HeartRate</div>
                <div class="vital-unit">bpm</div>
                @if (v.HeartRate > 100 || (v.HeartRate < 60 && v.HeartRate > 0))
                {
                    <span class="vital-flag"><svg width="10" height="10"><use href="#ic-alert" /></svg> Abnormal</span>
                }
                else
                {

                    <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle" /></svg> Normal</span>
                }
            </div>

            <div class="vital-card @glcClass">
                <div class="vital-label">Blood Glucose</div>
                <div class="vital-value">@v.BloodGlucose.ToString("0.0")</div>
                <div class="vital-unit">mmol/L</div>
                @if (v.BloodGlucose > 11)
                {
                    <span class="vital-flag"><svg width="10" height="10"><use href="#ic-alert" /></svg> High</span>
                }
                else if (v.BloodGlucose > 8)
                {

                    <span class="vital-warn">Borderline</span>
                }
                else
                {

                    <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle" /></svg> Normal</span>
                }
            </div>

            <div class="vital-card @tmpClass">
                <div class="vital-label">Temperature</div>
                <div class="vital-value">@v.Temperature.ToString("0.0")</div>
                <div class="vital-unit">°C</div>
                @if (v.Temperature > 39.5)
                {
                    <span class="vital-flag"><svg width="10" height="10"><use href="#ic-alert" /></svg> High fever</span>
                }
                else if (v.Temperature > 38)
                {

                    <span class="vital-warn">Fever</span>
                }
                else
                {

                    <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle" /></svg> Normal</span>
                }
            </div>

            <div class="vital-card vital-card--normal">
                <div class="vital-label">Weight</div>
                <div class="vital-value">@v.Weight.ToString("0.0")</div>
                <div class="vital-unit">kg</div>
                <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle" /></svg> Logged</span>
            </div>

            <div class="vital-card @(v.SleepHours < 7 && v.SleepHours > 0 ? "vital-card--caution" : "vital-card--normal")">
                <div class="vital-label">Sleep</div>
                <div class="vital-value">@v.SleepHours.ToString("0.0")</div>
                <div class="vital-unit">hours</div>
                @if (v.SleepHours < 7 && v.SleepHours > 0)
                {
                    <span class="vital-warn">Below target</span>
                }
                else
                {

                    <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle" /></svg> Good</span>
                }
            </div>

            <div class="vital-card @(v.WaterIntakeLitres < 2 && v.WaterIntakeLitres > 0 ? "vital-card--caution" : "vital-card--normal")">
                <div class="vital-label">Water Intake</div>
                <div class="vital-value">@v.WaterIntakeLitres.ToString("0.0")</div>
                <div class="vital-unit">litres</div>
                @if (v.WaterIntakeLitres < 2 && v.WaterIntakeLitres > 0)
                {
                    <span class="vital-warn">Below 2L</span>
                }
                else
                {

                    <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle" /></svg> Good</span>
                }
            </div>

            <div class="vital-card vital-card--normal">
                <div class="vital-label">Last Logged</div>
                <div class="vital-value" style="font-size:20px;">
                    @v.LoggedAt.ToString("dd MMM")
                </div>
                <div class="vital-unit">@v.LoggedAt.ToString("HH:mm")</div>
            </div>

        </div>

        <!-- Vitals history table -->
        @if (Model.RecentVitals.Count > 1)
        {
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Vitals History</div>
                    <span style="font-size:12.5px;color:var(--slate-soft);">
                        @Model.RecentVitals.Count readings
                    </span>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Date &amp; Time</th>
                                <th>BP (mmHg)</th>
                                <th>HR (bpm)</th>
                                <th>Glucose (mmol/L)</th>
                                <th>Temp (°C)</th>
                                <th>Flagged</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vital in Model.RecentVitals)
                            {
                                <tr>
                                    <td style="font-size:13px;color:var(--slate-soft);">
                                        @vital.LoggedAt.ToString("dd MMM yyyy · HH:mm")
                                    </td>
                                    <td style="@(vital.BloodPressureSystolic > 140 ? "color:var(--critical);font-weight:600;" : "")">
                                        @vital.BloodPressureSystolic/@vital.BloodPressureDiastolic
                                    </td>
                                    <td style="@(vital.HeartRate > 100 || (vital.HeartRate < 60 && vital.HeartRate > 0) ? "color:var(--critical);font-weight:600;" : "")">
                                        @vital.HeartRate
                                    </td>
                                    <td style="@(vital.BloodGlucose > 11 ? "color:var(--critical);font-weight:600;" : vital.BloodGlucose > 8 ? "color:var(--caution);font-weight:500;" : "")">
                                        @vital.BloodGlucose.ToString("0.0")
                                    </td>
                                    <td style="@(vital.Temperature > 38 ? "color:var(--caution);font-weight:500;" : "")">
                                        @vital.Temperature.ToString("0.0")
                                    </td>
                                    <td>
                                        <span class="badge @(vital.IsFlagged ? "badge-high" : "badge-stable")">
                                            @(vital.IsFlagged ? "Flagged" : "Clear")
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state" style="padding:40px 0;">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round"
                 style="margin:0 auto 12px;display:block;color:var(--border);">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
            </svg>
            No vitals logged yet for this patient.
        </div>
    }
</div>

<!-- ── SYMPTOMS & AI TAB ────────────────────────────────── -->
<div class="tab-panel" id="tab-symptoms">
    @if (!Model.RecentSymptoms.Any())
    {
        <div class="empty-state" style="padding:40px 0;">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round"
                 style="margin:0 auto 12px;display:block;color:var(--border);">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
            </svg>
            No symptoms logged yet.
        </div>
    }
    else
    {
        foreach (var symptom in Model.RecentSymptoms)
        {
            <div class="symptom-entry">
                <div class="symptom-top">
                    <div>
                        <div class="symptom-desc">@symptom.Description</div>
                        <div class="symptom-meta">
                            Area: @symptom.BodyArea &middot;
                            Severity: @symptom.Severity &middot;
                            @symptom.LoggedAt.ToString("dd MMM yyyy")
                        </div>
                    </div>
                    @if (symptom.AiAssessment != null)
                    {
                        <span class="badge badge-@symptom.AiAssessment.UrgencyLevel">
                            @symptom.AiAssessment.UrgencyLevel.ToUpper() Urgency
                        </span>
                    }
                </div>

                @if (symptom.AiAssessment != null)
                {
                    <div class="ai-assessment">
                        <div class="ai-header">
                            <div class="ai-label">
                                <div class="ai-icon">
                                    <svg width="12" height="12"><use href="#ic-sparkles" /></svg>
                                </div>
                                AI Symptom Assessment
                            </div>
                            <div class="ai-urgency urgency-@symptom.AiAssessment.UrgencyLevel">
                                @symptom.AiAssessment.UrgencyLevel.ToUpper() Urgency
                            </div>
                        </div>
                        <div class="ai-explanation">@symptom.AiAssessment.Explanation</div>
                        <div class="ai-recommendation">
                            <div class="ai-rec-icon">
                                <svg width="14" height="14"><use href="#ic-check-circle" /></svg>
                            </div>
                            @symptom.AiAssessment.Recommendation
                        </div>
                        <div class="ai-footer">
                            <div class="ai-timestamp">
                                Generated @symptom.AiAssessment.GeneratedAt.ToString("dd MMM yyyy") &middot;
                                @symptom.AiAssessment.ModelUsed
                            </div>
                            @if (!symptom.AiAssessment.DoctorOverride)
                            {
                                <div style="display:flex;gap:8px;">
                                    <button class="btn btn-ghost btn-sm"
                                            onclick="openOverrideModal('@symptom.Id')">
                                        Override
                                    </button>
                                    <form asp-action="AddNote" asp-controller="Doctor" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="patientId" value="@symptom.PatientId" />
                                        <input type="hidden" name="note"
                                               value="Agreed with AI assessment for: @symptom.Description" />
                                        <input type="hidden" name="isAlert" value="false" />
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            Agree &amp; Note
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="badge badge-caution">Overridden</span>
                            }
                        </div>
                    </div>

                    @if (symptom.AiAssessment.DoctorOverride &&
                            !string.IsNullOrEmpty(symptom.AiAssessment.DoctorNote))
                    {
                        <div class="doctor-override">
                            <div class="override-label">Your Override Note</div>
                            <div class="note-text">@symptom.AiAssessment.DoctorNote</div>
                        </div>
                    }
                }
            </div>
        }
    }
</div>

<!-- ── CLINICAL NOTES TAB ───────────────────────────────── -->
<div class="tab-panel" id="tab-notes">
    <div style="display:flex;justify-content:flex-end;margin-bottom:14px;">
        <button class="btn btn-primary btn-sm" onclick="openModal('addNoteModal')">
            <svg width="13" height="13"><use href="#ic-plus" /></svg> Add Note
        </button>
    </div>
    @if (!notes.Any())
    {
        <div class="empty-state" style="padding:32px 0;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round"
                 style="margin:0 auto 12px;display:block;color:var(--border);">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
            </svg>
            No clinical notes yet.
        </div>
    }
    else
    {
        foreach (var note in notes)
        {
            <div class="note-item @(note.IsAlert ? "note-item-alert" : "")">
                @if (note.IsAlert)
                {
                    <div style="display:flex;align-items:center;gap:6px;margin-bottom:7px;">
                        <svg width="13" height="13" style="color:var(--critical);">
                            <use href="#ic-alert" />
                        </svg>
                        <span style="font-size:11px;font-weight:700;color:var(--critical);
                                                 text-transform:uppercase;letter-spacing:0.5px;">
                            Alert
                        </span>
                    </div>
                }
                <div class="note-text">@note.Note</div>
                <div class="note-meta">@note.CreatedAt.ToString("dd MMM yyyy · HH:mm")</div>
            </div>
        }
    }
</div>

<!-- ── APPOINTMENTS TAB ─────────────────────────────────── -->
<div class="tab-panel" id="tab-appointments">
    @if (!Model.UpcomingAppointments.Any())
    {
        <div class="empty-state" style="padding:32px 0;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round"
                 style="margin:0 auto 12px;display:block;color:var(--border);">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            No appointments on record for this patient.
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Reason</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.UpcomingAppointments)
                        {
                            var statusClass = appt.Status switch
                            {
                                "confirmed" => "badge-active",
                                "cancelled" => "badge-inactive",
                                "completed" => "badge-stable",
                                _ => "badge-pending"
                            };
                            <tr>
                                <td>@appt.Date</td>
                                <td>@appt.TimeSlot</td>
                                <td>@appt.Reason</td>
                                <td>
                                    <span class="badge @statusClass">@appt.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ── Add Note Modal ───────────────────────────────────── -->
<div class="modal-overlay" id="addNoteModal">
    <div class="modal">
        <div class="modal-title">Add Clinical Note</div>
        <div class="modal-sub">
            This note will be saved to @Model.CurrentUser.FullName's record.
        </div>
        <form asp-action="AddNote" asp-controller="Doctor" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="patientId" value="@Model.CurrentUser.Id" />
            <div class="form-group">
                <label class="form-label">Note</label>
                <textarea name="note" class="form-textarea"
                          placeholder="Write your clinical note here..."></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Send as Alert to Patient</label>
                <select name="isAlert" class="form-select">
                    <option value="false">No — standard note</option>
                    <option value="true">Yes — notify patient</option>
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('addNoteModal')">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary">Save Note</button>
            </div>
        </form>
    </div>
</div>

<!-- ── Override Modal ───────────────────────────────────── -->
<div class="modal-overlay" id="overrideModal">
    <div class="modal">
        <div class="modal-title">Override AI Assessment</div>
        <div class="modal-sub">
            Provide your clinical reasoning for overriding this assessment.
        </div>
        <form asp-action="OverrideAssessment" asp-controller="Doctor" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="overrideSymptomId" name="symptomId" />
            <input type="hidden" name="patientId" value="@Model.CurrentUser.Id" />
            <div class="form-group">
                <label class="form-label">Your Clinical Note</label>
                <textarea name="doctorNote" class="form-textarea"
                          placeholder="Explain your clinical reasoning..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('overrideModal')">
                    Cancel
                </button>
                <button type="submit" class="btn btn-primary">Confirm Override</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function showTab(id, btn) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById('tab-' + id).classList.add('active');
            btn.classList.add('active');
        }
        function openModal(id)  { document.getElementById(id).classList.add('open'); }
        function closeModal(id) { document.getElementById(id).classList.remove('open'); }
        function openOverrideModal(symptomId) {
            document.getElementById('overrideSymptomId').value = symptomId;
            openModal('overrideModal');
        }
        document.querySelectorAll('.modal-overlay').forEach(o => {
            o.addEventListener('click', e => { if (e.target === o) o.classList.remove('open'); });
        });
    </script>
