@model HealthSpark.ViewModels.DashboardViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "My Patients";
    ViewData["ActivePage"] = "Patients";
    ViewData["Sidebar"] = "_DoctorSidebar";
    ViewData["CurrentUserName"] = Model.CurrentUser?.FullName ?? "Doctor";
    ViewData["DoctorSpecialisation"] = Model.DoctorProfile?.Specialisation ?? "Doctor";
    ViewData["AlertCount"] = Model.UnreadAlertsCount;
}

<!-- Search Row -->
<div class="search-row">
    <div class="search-wrap">
        <span class="s-icon">
            <svg width="14" height="14"><use href="#ic-search" /></svg>
        </span>
        <input class="search-input" id="patientSearch"
               placeholder="Search patients..."
               onkeyup="filterTable('patientSearch', 'patientTable')" />
    </div>
    <span style="font-size:13px;color:var(--slate-soft);margin-left:auto;">
        @Model.AssignedPatients.Count patient@(Model.AssignedPatients.Count == 1 ? "" : "s") assigned
    </span>
</div>

<!-- Patients Table -->
<div class="card">
    <div class="card-header">
        <div class="card-title">My Patients</div>
    </div>
    <div class="table-wrap">
        <table id="patientTable">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Gender</th>
                    <th>Date of Birth</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.AssignedPatients.Any())
                {
                    <tr>
                        <td colspan="5">
                            <div class="empty-state" style="padding:32px 0;">
                                No patients assigned yet. Contact your admin.
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var patient in Model.AssignedPatients)
                    {
                        var initials = patient.FullName.Length >= 2
                        ? patient.FullName[..2].ToUpper()
                        : patient.FullName.ToUpper();
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="avatar av-1">@initials</div>
                                    <div>
                                        <div class="user-name">@patient.FullName</div>
                                        <div class="user-email">@patient.Email</div>
                                    </div>
                                </div>
                            </td>
                            <td style="color:var(--slate-soft);font-size:13px;">
                                @(string.IsNullOrEmpty(patient.Gender) ? "—" : patient.Gender)
                            </td>
                            <td style="color:var(--slate-soft);font-size:13px;">
                                @(string.IsNullOrEmpty(patient.DateOfBirth) ? "—" : patient.DateOfBirth)
                            </td>
                            <td>
                                <span class="badge @(patient.IsActive ? "badge-active" : "badge-inactive")">
                                    @(patient.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div class="action-row">
                                    <a href="@Url.Action("PatientDetail", "Doctor", new { patientId = patient.Id })"
                                       class="tbl-btn tbl-btn-view" title="View patient">
                                        <svg width="13" height="13"><use href="#ic-eye" /></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable(inputId, tableId) {
            const filter = document.getElementById(inputId).value.toLowerCase();
            document.querySelectorAll(`#${tableId} tbody tr`).forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        }
    </script>
}