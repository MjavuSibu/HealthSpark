@model HealthSpark.ViewModels.DashboardViewModel
@using System.Linq
@using System.Text.Json

@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Dashboard";
    ViewData["Sidebar"] = "_PatientSidebar";
    ViewData["CurrentUserName"] = Model.CurrentUser?.FullName ?? "Patient";
    ViewData["AlertCount"] = Model.Alerts?.Count ?? 0;

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Hello" : hour < 17 ? "Good afternoon" : "Good evening";
    var firstName = Model.CurrentUser?.FullName?.Split(' ')[0] ?? "there";

    int riskScore = 0;
    var riskFlags = new List<string>();
    var v = Model.LatestVital;

    if (v != null)
    {
        if      (v.BloodPressureSystolic > 180) { riskScore += 30; riskFlags.Add("Hypertensive crisis"); }
        else if (v.BloodPressureSystolic > 140) { riskScore += 20; riskFlags.Add("High BP"); }
        else if (v.BloodPressureSystolic > 130) { riskScore += 10; riskFlags.Add("Elevated BP"); }
        else if (v.BloodPressureSystolic < 90 && v.BloodPressureSystolic > 0) { riskScore += 15; riskFlags.Add("Low BP"); }
        if      (v.HeartRate > 120) { riskScore += 20; riskFlags.Add("Tachycardia"); }
        else if (v.HeartRate > 100) { riskScore += 12; riskFlags.Add("Elevated HR"); }
        else if (v.HeartRate < 50 && v.HeartRate > 0) { riskScore += 15; riskFlags.Add("Bradycardia"); }
        else if (v.HeartRate < 60 && v.HeartRate > 0) { riskScore += 5; riskFlags.Add("Low HR"); }
        if      (v.BloodGlucose > 14)  { riskScore += 20; riskFlags.Add("Severely high glucose"); }
        else if (v.BloodGlucose > 11)  { riskScore += 12; riskFlags.Add("High glucose"); }
        else if (v.BloodGlucose > 8)   { riskScore += 6;  riskFlags.Add("Borderline glucose"); }
        else if (v.BloodGlucose < 3.9 && v.BloodGlucose > 0) { riskScore += 15; riskFlags.Add("Low glucose"); }
        if      (v.Temperature > 39.5) { riskScore += 15; riskFlags.Add("High fever"); }
        else if (v.Temperature > 38)   { riskScore += 8;  riskFlags.Add("Fever"); }
        if      (v.SleepHours < 5 && v.SleepHours > 0) { riskScore += 8; riskFlags.Add("Severe sleep deficit"); }
        else if (v.SleepHours < 7 && v.SleepHours > 0) { riskScore += 4; riskFlags.Add("Poor sleep"); }
        if (v.WaterIntakeLitres < 1 && v.WaterIntakeLitres > 0) { riskScore += 7; riskFlags.Add("Low water intake"); }
    }
    riskScore = Math.Min(riskScore, 100);
    var riskBand  = riskScore >= 60 ? "Critical" : riskScore >= 35 ? "Moderate" : riskScore >= 15 ? "Low Risk" : "Stable";
    var riskClass = riskScore >= 60 ? "risk--critical" : riskScore >= 35 ? "risk--moderate" : "risk--stable";

    var insights = new List<string>();
    var recentVitals = Model.RecentVitals ?? new List<HealthSpark.Models.Vital>();
    if (recentVitals.Count >= 3)
    {
        var recentBP = recentVitals.Take(5).Select(x => x.BloodPressureSystolic).ToList();
        if (recentBP.All(bp => bp > 130))
            insights.Add($"Your blood pressure has been elevated across your last {recentBP.Count} readings. Consider booking an appointment.");
        var sleepList = recentVitals.Take(7).Where(x => x.SleepHours > 0).Select(x => x.SleepHours).ToList();
        if (sleepList.Count >= 3)
        {
            bool declining = true;
            for (int i = 1; i < sleepList.Count; i++)
                if (sleepList[i] >= sleepList[i - 1]) { declining = false; break; }
            if (declining && sleepList.Last() < 6)
                insights.Add("Your sleep has been declining this week. Poor sleep increases cardiovascular risk.");
        }
        var glucoseList = recentVitals.Take(5).Where(x => x.BloodGlucose > 0).Select(x => x.BloodGlucose).ToList();
        if (glucoseList.Count >= 3 && glucoseList.First() < glucoseList.Last() - 1)
            insights.Add("Your blood glucose levels have been improving. Keep it up!");
    }

    var bpClass  = v == null ? "vital-card--nodata" : v.BloodPressureSystolic > 140 ? "vital-card--critical" : v.BloodPressureSystolic > 130 ? "vital-card--caution" : "vital-card--normal";
    var hrClass  = v == null ? "vital-card--nodata" : (v.HeartRate > 100 || (v.HeartRate < 60 && v.HeartRate > 0)) ? "vital-card--critical" : "vital-card--normal";
    var glcClass = v == null ? "vital-card--nodata" : v.BloodGlucose > 11 ? "vital-card--critical" : v.BloodGlucose > 8 ? "vital-card--caution" : "vital-card--normal";
    var slpClass = v == null ? "vital-card--nodata" : (v.SleepHours < 5 && v.SleepHours > 0) ? "vital-card--critical" : (v.SleepHours < 7 && v.SleepHours > 0) ? "vital-card--caution" : "vital-card--normal";

    var upcomingAppointments = Model.UpcomingAppointments ?? new List<HealthSpark.Models.Appointment>();
    var alerts               = Model.Alerts              ?? new List<HealthSpark.Models.Alert>();
}

<!-- ── Welcome Banner with ECG Animation ──────────────── -->
<div class="welcome-banner" style="
    background: none;
    padding: 0;
    overflow: hidden;
    position: relative;
    border-radius: var(--radius-lg);
    margin-bottom: 24px;
    min-height: 160px;">

    <!-- ECG Canvas -->
    <canvas id="ecgBanner" style="
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        border-radius: var(--radius-lg);
        display: block;"></canvas>

    <!-- Text overlay -->
    <div style="
        position: relative;
        z-index: 2;
        padding: 30px 34px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        min-height: 160px;">
        <div class="welcome-title" style="
            color: white;
            text-shadow: 0 1px 8px rgba(0,0,0,0.4);">
            @greeting, @firstName
        </div>
        <div class="welcome-sub" style="color: rgba(255,255,255,0.78);">
            @if (upcomingAppointments.Any())
            {
                var next = upcomingAppointments.First();
                <span>You have an appointment on @next.Date at @next.TimeSlot. Don't forget to log your vitals.</span>
            }
            else
            {
                <span>Welcome back. Remember to log your vitals today.</span>
            }
        </div>
        <div class="welcome-date" style="
            margin-top: 14px;
            font-size: 10px;
            opacity: 0.45;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: white;">
            @DateTime.Now.ToString("dddd, dd MMMM yyyy")
        </div>
    </div>
</div>

<!-- ── Quick Actions ───────────────────────────────────── -->
<div class="quick-actions">
    <div class="quick-card" onclick="openModal('logVitalsModal')">
        <div class="quick-icon qi-forest">
            <svg width="18" height="18"><use href="#ic-heart-pulse" /></svg>
        </div>
        <div class="quick-title">Log Vitals</div>
        <div class="quick-sub">@(v != null ? $"Last: {v.LoggedAt:dd MMM}" : "Not logged yet")</div>
    </div>
    <div class="quick-card" onclick="window.location='@Url.Action("Symptoms", "Patient")'">
        <div class="quick-icon qi-caution">
            <svg width="18" height="18"><use href="#ic-clipboard" /></svg>
        </div>
        <div class="quick-title">Log Symptom</div>
        <div class="quick-sub">Get AI assessment</div>
    </div>
    <div class="quick-card" onclick="openModal('bookApptModal')">
        <div class="quick-icon qi-stable">
            <svg width="18" height="18"><use href="#ic-calendar" /></svg>
        </div>
        <div class="quick-title">Book Appointment</div>
        <div class="quick-sub">@(upcomingAppointments.Any() ? $"Next: {upcomingAppointments.First().Date}" : "No upcoming")</div>
    </div>
    <div class="quick-card" onclick="window.location='@Url.Action("DoctorNotes", "Patient")'">
        <div class="quick-icon qi-gold">
            <svg width="18" height="18"><use href="#ic-stethoscope" /></svg>
        </div>
        <div class="quick-title">My Doctor</div>
        <div class="quick-sub">View notes &amp; info</div>
    </div>
</div>

<!-- ── Health Risk Score Card ──────────────────────────── -->
@if (v != null)
{
    <div class="risk-score-card @riskClass">
        <div class="risk-score-dial">
            <canvas id="riskDial" width="80" height="80"></canvas>
            <div class="risk-score-number">
                <div class="risk-score-value">@riskScore</div>
                <div class="risk-score-max">/ 100</div>
            </div>
        </div>
        <div class="risk-score-info">
            <div class="risk-score-label">Health Risk Score</div>
            <div class="risk-score-band">@riskBand</div>
            <div class="risk-flags">
                @if (!riskFlags.Any())
                {
                    <span class="insight-chip chip--stable">All readings within normal range</span>
                }
                else
                {
                    foreach (var flag in riskFlags)
                    {
                        <span class="insight-chip @(riskScore >= 60 ? "chip--critical" : "")">@flag</span>
                    }
                }
            </div>
        </div>
        <div style="text-align:right;flex-shrink:0;">
            <div style="font-size:10.5px;color:var(--slate-muted);text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">Last logged</div>
            <div style="font-size:14px;font-weight:600;color:var(--slate);">@v.LoggedAt.ToString("dd MMM")</div>
            <div style="font-size:12px;color:var(--slate-soft);">@v.LoggedAt.ToString("HH:mm")</div>
        </div>
    </div>
}

<!-- ── Smart Insights Strip ────────────────────────────── -->
@if (insights.Any())
{
    <div class="insights-strip">
        @foreach (var insight in insights)
        {
            <div class="insight-row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                </svg>
                @insight
            </div>
        }
    </div>
}

<!-- ── Vital Cards ─────────────────────────────────────── -->
<div class="vitals-grid">
    <div class="vital-card @bpClass">
        <div class="vital-label">Blood Pressure</div>
        @if (v != null)
        {
            <div class="vital-value" style="font-size:22px;">@v.BloodPressureSystolic<span style="font-size:16px;font-weight:400;color:var(--slate-soft);">/@v.BloodPressureDiastolic</span></div>
            <div class="vital-unit">mmHg</div>
            <canvas class="vital-sparkline" id="spark-bp"></canvas>
            @if (v.BloodPressureSystolic > 140)     { <span class="vital-flag"><svg width="10" height="10"><use href="#ic-alert"/></svg> High</span> }
            else if (v.BloodPressureSystolic > 130) { <span class="vital-warn">Elevated</span> }
            else                                    { <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle"/></svg> Normal</span> }
        }
        else { <div class="vital-value" style="font-size:18px;color:var(--slate-muted);">—</div><div class="vital-unit">mmHg</div> }
    </div>
    <div class="vital-card @hrClass">
        <div class="vital-label">Heart Rate</div>
        @if (v != null)
        {
            <div class="vital-value">@v.HeartRate</div>
            <div class="vital-unit">bpm</div>
            <canvas class="vital-sparkline" id="spark-hr"></canvas>
            @if (v.HeartRate > 100 || (v.HeartRate < 60 && v.HeartRate > 0)) { <span class="vital-flag"><svg width="10" height="10"><use href="#ic-alert"/></svg> @(v.HeartRate > 100 ? "High" : "Low")</span> }
            else { <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle"/></svg> Normal</span> }
        }
        else { <div class="vital-value" style="font-size:18px;color:var(--slate-muted);">—</div><div class="vital-unit">bpm</div> }
    </div>
    <div class="vital-card @glcClass">
        <div class="vital-label">Blood Glucose</div>
        @if (v != null)
        {
            <div class="vital-value">@v.BloodGlucose.ToString("0.0")</div>
            <div class="vital-unit">mmol/L</div>
            <canvas class="vital-sparkline" id="spark-glc"></canvas>
            @if (v.BloodGlucose > 11)    { <span class="vital-flag"><svg width="10" height="10"><use href="#ic-alert"/></svg> High</span> }
            else if (v.BloodGlucose > 8) { <span class="vital-warn">Borderline</span> }
            else                         { <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle"/></svg> Normal</span> }
        }
        else { <div class="vital-value" style="font-size:18px;color:var(--slate-muted);">—</div><div class="vital-unit">mmol/L</div> }
    </div>
    <div class="vital-card @slpClass">
        <div class="vital-label">Sleep Last Night</div>
        @if (v != null)
        {
            <div class="vital-value">@v.SleepHours.ToString("0.0")</div>
            <div class="vital-unit">hours</div>
            <canvas class="vital-sparkline" id="spark-slp"></canvas>
            @if (v.SleepHours < 5 && v.SleepHours > 0)     { <span class="vital-flag"><svg width="10" height="10"><use href="#ic-alert"/></svg> Too low</span> }
            else if (v.SleepHours < 7 && v.SleepHours > 0) { <span class="vital-warn">Below target</span> }
            else                                            { <span class="vital-ok"><svg width="10" height="10"><use href="#ic-check-circle"/></svg> Good</span> }
        }
        else { <div class="vital-value" style="font-size:18px;color:var(--slate-muted);">—</div><div class="vital-unit">hours</div> }
    </div>
</div>

<!-- ── Main Grid ───────────────────────────────────────── -->
<div class="grid-3">
    <div>
        <div class="card" style="margin-bottom:0;">
            <div class="card-header">
                <div class="card-title">7-Day Vitals Trend</div>
                <a href="@Url.Action("Vitals", "Patient")" class="btn btn-ghost btn-sm">Full history</a>
            </div>
            @if (recentVitals.Count >= 2)
            {
                <div class="chart-container">
                    <canvas id="trendChart" height="180"></canvas>
                </div>
            }
            else
            {
                <div class="empty-state" style="padding:40px 20px;">Log at least 2 vital readings to see your trend chart.</div>
            }
        </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:18px;">
        <div class="card" style="margin-bottom:0;">
            <div class="card-header">
                <div class="card-title">Appointments</div>
                <a href="@Url.Action("Appointments", "Patient")" class="btn btn-ghost btn-sm">View all</a>
            </div>
            <div class="card-body">
                @if (!upcomingAppointments.Any())
                {
                    <div class="empty-state" style="padding:16px 0;">No upcoming appointments.</div>
                }
                else
                {
                    foreach (var appt in upcomingAppointments.Take(3))
                    {
                        <div class="appt-item">
                            <div class="appt-date-block">
                                <div class="appt-day">@(appt.Date?.Split(' ').ElementAtOrDefault(0) ?? "—")</div>
                                <div class="appt-month">@(appt.Date?.Split(' ').ElementAtOrDefault(1) ?? "")</div>
                            </div>
                            <div class="appt-divider"></div>
                            <div class="appt-info">
                                <div class="appt-title">@appt.Reason</div>
                                <div class="appt-doctor">@appt.TimeSlot</div>
                            </div>
                            <span class="badge @(appt.Status == "confirmed" ? "badge-active" : "badge-pending")">@appt.Status</span>
                        </div>
                    }
                }
            </div>
        </div>

        @if (alerts.Any())
        {
            <div class="card" style="margin-bottom:0;border-left:3px solid var(--critical);">
                <div class="card-header">
                    <div class="card-title" style="color:var(--critical);">Latest Alert</div>
                </div>
                <div class="card-body">
                    <div style="display:flex;gap:10px;align-items:flex-start;">
                        <div class="alert-icon" style="flex-shrink:0;">
                            <svg width="15" height="15"><use href="#ic-alert"/></svg>
                        </div>
                        <div>
                            <div style="font-size:13px;font-weight:500;color:var(--slate);">@alerts.First().Message</div>
                            <div style="font-size:11px;color:var(--slate-muted);margin-top:6px;">
                                @{
                                    var ago = DateTime.UtcNow - alerts.First().CreatedAt;
                                    var agoText = ago.TotalHours < 1 ? $"{(int)ago.TotalMinutes} mins ago" : ago.TotalHours < 24 ? $"{(int)ago.TotalHours} hrs ago" : $"{(int)ago.TotalDays} days ago";
                                }
                                @agoText
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.LatestDoctorNote != null)
        {
            <div class="card" style="margin-bottom:0;border-left:3px solid var(--forest);">
                <div class="card-header">
                    <div class="card-title">Doctor's Note</div>
                </div>
                <div class="card-body">
                    <div style="font-size:13px;color:var(--slate-mid);line-height:1.65;">@Model.LatestDoctorNote.Note</div>
                    <div style="font-size:11px;color:var(--slate-muted);margin-top:10px;">@Model.LatestDoctorNote.CreatedAt.ToString("dd MMM yyyy · HH:mm")</div>
                </div>
            </div>
        }
    </div>
</div>

<!-- ── Log Vitals Modal ────────────────────────────────── -->
<div class="modal-overlay" id="logVitalsModal">
    <div class="modal">
        <div class="modal-title">Log Vitals</div>
        <div class="modal-sub">All fields are optional — log what you have available.</div>
        <form asp-action="LogVitals" asp-controller="Patient" method="post">
            @Html.AntiForgeryToken()
            <div class="vitals-form-grid">
                <div class="form-group"><label class="form-label">Systolic BP</label><div class="input-with-unit"><input name="BloodPressureSystolic" class="form-input" type="number" placeholder="e.g. 120" /><span class="input-unit">mmHg</span></div></div>
                <div class="form-group"><label class="form-label">Diastolic BP</label><div class="input-with-unit"><input name="BloodPressureDiastolic" class="form-input" type="number" placeholder="e.g. 80" /><span class="input-unit">mmHg</span></div></div>
                <div class="form-group"><label class="form-label">Heart Rate</label><div class="input-with-unit"><input name="HeartRate" class="form-input" type="number" placeholder="e.g. 72" /><span class="input-unit">bpm</span></div></div>
                <div class="form-group"><label class="form-label">Blood Glucose</label><div class="input-with-unit"><input name="BloodGlucose" class="form-input" type="number" step="0.1" placeholder="e.g. 7.2" /><span class="input-unit">mmol/L</span></div></div>
                <div class="form-group"><label class="form-label">Temperature</label><div class="input-with-unit"><input name="Temperature" class="form-input" type="number" step="0.1" placeholder="e.g. 37.0" /><span class="input-unit">°C</span></div></div>
                <div class="form-group"><label class="form-label">Weight</label><div class="input-with-unit"><input name="Weight" class="form-input" type="number" step="0.1" placeholder="e.g. 80" /><span class="input-unit">kg</span></div></div>
                <div class="form-group"><label class="form-label">Sleep Last Night</label><div class="input-with-unit"><input name="SleepHours" class="form-input" type="number" step="0.5" placeholder="e.g. 7.5" /><span class="input-unit">hrs</span></div></div>
                <div class="form-group"><label class="form-label">Water Intake</label><div class="input-with-unit"><input name="WaterIntakeLitres" class="form-input" type="number" step="0.1" placeholder="e.g. 2.0" /><span class="input-unit">L</span></div></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('logVitalsModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Save Vitals</button>
            </div>
        </form>
    </div>
</div>

<!-- ── Book Appointment Modal ─────────────────────────── -->
<div class="modal-overlay" id="bookApptModal">
    <div class="modal">
        <div class="modal-title">Book Appointment</div>
        <div class="modal-sub">Request an appointment with your doctor.</div>
        <form asp-action="BookAppointment" asp-controller="Patient" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group"><label class="form-label">Preferred Date</label><input name="Date" class="form-input" type="date" min="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
            <div class="form-group">
                <label class="form-label">Preferred Time</label>
                <select name="TimeSlot" class="form-select">
                    <option value="09:00 AM">09:00 AM</option>
                    <option value="10:00 AM">10:00 AM</option>
                    <option value="11:00 AM">11:00 AM</option>
                    <option value="12:00 PM">12:00 PM</option>
                    <option value="02:00 PM">02:00 PM</option>
                    <option value="03:00 PM">03:00 PM</option>
                </select>
            </div>
            <div class="form-group"><label class="form-label">Reason for Appointment</label><textarea name="Reason" class="form-textarea" placeholder="Briefly describe why you'd like to book..."></textarea></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" onclick="closeModal('bookApptModal')">Cancel</button>
                <button type="submit" class="btn btn-primary">Request Appointment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
/* ═══════════════════════════════════════════════════
   ECG BANNER ANIMATION
   ═══════════════════════════════════════════════════ */
(function() {
    const el  = document.getElementById('ecgBanner');
    if (!el) return;
    const ctx = el.getContext('2d');

    function resize() {
        const rect = el.parentElement.getBoundingClientRect();
        el.width  = rect.width  || 800;
        el.height = rect.height || 160;
    }
    resize();
    new ResizeObserver(resize).observe(el.parentElement);

    /* palette */
    const BG      = '#020B14';
    const GRID    = 'rgba(0,180,120,0.055)';
    const PARTS   = ['rgba(0,200,150,','rgba(0,170,255,','rgba(0,240,200,'];

    /* particles */
    const particles = Array.from({length: 30}, () => ({
        x: Math.random(), y: Math.random(),
        r: Math.random() * 1.4 + 0.3,
        vx: (Math.random()-0.5)*0.0003, vy: (Math.random()-0.5)*0.0003,
        a: Math.random()*0.45+0.12, c: Math.floor(Math.random()*3),
        ph: Math.random()*Math.PI*2
    }));

    /* ECG shape */
    function ecgY(x, t, spd, amp, off) {
        const w   = el.width;
        const per = w * 0.50;
        const pos = ((x + t*spd*w + off) % per + per) % per;
        const n   = pos / per;
        if (n < 0.28) return 0;
        if (n < 0.31) return -Math.sin((n-0.28)/0.03*Math.PI)*amp*0.18;
        if (n < 0.35) return  Math.sin((n-0.31)/0.04*Math.PI)*amp;
        if (n < 0.38) return -Math.sin((n-0.35)/0.03*Math.PI)*amp*0.44;
        if (n < 0.46) return  Math.sin((n-0.38)/0.08*Math.PI)*amp*0.22;
        return 0;
    }

    const LINES = [
        { yf:0.22, spd:0.018, col:'#00C896', gl:'rgba(0,200,150,0.65)', amp:32, lw:2.0, off:0   },
        { yf:0.44, spd:0.012, col:'#00AAFF', gl:'rgba(0,170,255,0.55)', amp:22, lw:1.5, off:280 },
        { yf:0.66, spd:0.022, col:'#00C896', gl:'rgba(0,200,150,0.55)', amp:16, lw:1.3, off:560 },
        { yf:0.85, spd:0.010, col:'#00AAFF', gl:'rgba(0,170,255,0.45)', amp:12, lw:1.0, off:840 },
    ];
    const la = LINES.map(() => 0);

    let t = 0, tick = 0;
    ctx.fillStyle = BG;
    ctx.fillRect(0, 0, el.width, el.height);

    function frame() {
        t    += 0.016;
        tick += 1;
        const w = el.width, h = el.height;

        /* trail */
        ctx.fillStyle = 'rgba(2,11,20,0.18)';
        ctx.fillRect(0,0,w,h);
        if (tick % 5 === 0) {
            ctx.save(); ctx.globalAlpha = 0.06;
            ctx.fillStyle = BG; ctx.fillRect(0,0,w,h); ctx.restore();
        }

        /* grid */
        ctx.save(); ctx.strokeStyle = GRID; ctx.lineWidth = 0.5;
        for (let x=0;x<w;x+=36){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,h);ctx.stroke();}
        for (let y=0;y<h;y+=36){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke();}
        ctx.restore();

        /* particles */
        particles.forEach(p => {
            p.x+=p.vx; p.y+=p.vy;
            if(p.x<0)p.x=1; if(p.x>1)p.x=0;
            if(p.y<0)p.y=1; if(p.y>1)p.y=0;
            const pulse = 0.5+0.5*Math.sin(t*1.2+p.ph);
            const al    = p.a*(0.4+0.6*pulse);
            ctx.save();
            ctx.globalAlpha = al;
            ctx.fillStyle   = PARTS[p.c]+(al*0.9)+')';
            ctx.shadowBlur  = 5; ctx.shadowColor = PARTS[p.c]+'0.5)';
            ctx.beginPath(); ctx.arc(p.x*w,p.y*h,p.r,0,Math.PI*2); ctx.fill();
            ctx.restore();
        });

        /* ECG lines */
        LINES.forEach((L,i) => {
            la[i] = Math.min(0.85, la[i] + (tick > i*30 ? 0.008 : 0));
            if (la[i] <= 0) return;
            const baseY = L.yf * h;
            ctx.save();
            ctx.globalAlpha = la[i];
            ctx.shadowBlur  = 18; ctx.shadowColor = L.gl;
            ctx.strokeStyle = L.col; ctx.lineWidth = L.lw;
            ctx.lineCap = 'round'; ctx.lineJoin = 'round';
            ctx.beginPath();
            for(let x=0;x<=w;x+=2){
                const dy = ecgY(x,t,L.spd,L.amp,L.off);
                x===0 ? ctx.moveTo(x,baseY+dy) : ctx.lineTo(x,baseY+dy);
            }
            ctx.stroke();

            /* head dot */
            const hx = (w-(t*L.spd*w)%w+w)%w;
            const hy = baseY+ecgY(hx,t,L.spd,L.amp,L.off);
            ctx.shadowBlur = 24; ctx.fillStyle = '#FFFFFF';
            ctx.globalAlpha = la[i]*0.9;
            ctx.beginPath(); ctx.arc(hx,hy,L.lw*1.8,0,Math.PI*2); ctx.fill();
            ctx.restore();
        });

        /* vignette */
        const vg = ctx.createRadialGradient(w/2,h/2,h*0.1,w/2,h/2,w*0.6);
        vg.addColorStop(0,'rgba(0,0,0,0)');
        vg.addColorStop(1,'rgba(0,0,0,0.52)');
        ctx.save(); ctx.fillStyle=vg; ctx.fillRect(0,0,w,h); ctx.restore();

        requestAnimationFrame(frame);
    }
    frame();
})();

/* ═══════════════════════════════════════════════════
   MODALS
   ═══════════════════════════════════════════════════ */
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-overlay').forEach(o => {
    o.addEventListener('click', e => { if (e.target === o) o.classList.remove('open'); });
});

/* ═══════════════════════════════════════════════════
   VITALS DATA + CHARTS
   ═══════════════════════════════════════════════════ */
const vitalsHistory = @Html.Raw(JsonSerializer.Serialize(
    (Model.RecentVitals ?? new List<HealthSpark.Models.Vital>())
        .Take(7).Reverse().Select(x => new {
            date      = x.LoggedAt.ToString("dd MMM"),
            systolic  = x.BloodPressureSystolic,
            diastolic = x.BloodPressureDiastolic,
            heartRate = x.HeartRate,
            glucose   = x.BloodGlucose,
            sleep     = x.SleepHours
        })
));

/* Risk dial */
const riskScore  = @riskScore;
const dialCanvas = document.getElementById('riskDial');
if (dialCanvas) {
    const dialColor = riskScore >= 60 ? '#C0392B' : riskScore >= 35 ? '#D4720E' : '#1E8C4E';
    new Chart(dialCanvas, {
        type: 'doughnut',
        data: { datasets: [{ data: [riskScore, 100-riskScore], backgroundColor: [dialColor,'rgba(0,0,0,0.06)'], borderWidth:0, circumference:270, rotation:-135 }] },
        options: { cutout:'76%', animation:{duration:900}, plugins:{legend:{display:false},tooltip:{enabled:false}} }
    });
}

/* Sparklines */
function sparkline(id, values, color) {
    const el = document.getElementById(id);
    if (!el || values.length < 2) return;
    new Chart(el, {
        type: 'line',
        data: { labels: values.map((_,i)=>i), datasets:[{data:values,borderColor:color,borderWidth:1.8,pointRadius:0,fill:false,tension:0.4}] },
        options: { animation:false, responsive:false, plugins:{legend:{display:false},tooltip:{enabled:false}}, scales:{x:{display:false},y:{display:false}} }
    });
}
if (vitalsHistory.length >= 2) {
    sparkline('spark-bp',  vitalsHistory.map(x=>x.systolic),  '#C0392B');
    sparkline('spark-hr',  vitalsHistory.map(x=>x.heartRate), '#1B5E37');
    sparkline('spark-glc', vitalsHistory.map(x=>x.glucose),   '#D4720E');
    sparkline('spark-slp', vitalsHistory.map(x=>x.sleep),     '#2D7A50');
}

/* Trend chart */
const trendCanvas = document.getElementById('trendChart');
if (trendCanvas && vitalsHistory.length >= 2) {
    new Chart(trendCanvas, {
        type: 'line',
        data: {
            labels: vitalsHistory.map(x=>x.date),
            datasets: [
                { label:'Systolic BP',     data:vitalsHistory.map(x=>x.systolic),  borderColor:'#C0392B', backgroundColor:'rgba(192,57,43,0.06)',  fill:true,  tension:0.4, pointRadius:3, pointBackgroundColor:'#C0392B' },
                { label:'Heart Rate',       data:vitalsHistory.map(x=>x.heartRate), borderColor:'#1B5E37', backgroundColor:'rgba(27,94,55,0.06)',   fill:true,  tension:0.4, pointRadius:3, pointBackgroundColor:'#1B5E37' },
                { label:'Glucose (mmol/L)', data:vitalsHistory.map(x=>x.glucose),   borderColor:'#D4720E', backgroundColor:'transparent',            fill:false, tension:0.4, pointRadius:3, borderDash:[4,3], pointBackgroundColor:'#D4720E' }
            ]
        },
        options: {
            responsive:true,
            interaction:{mode:'index',intersect:false},
            plugins:{legend:{position:'bottom',labels:{font:{family:'DM Sans',size:11},color:'#6B8078',boxWidth:10,padding:16}}},
            scales:{
                x:{grid:{display:false},ticks:{font:{family:'DM Sans',size:11},color:'#9DB0A8'}},
                y:{grid:{color:'rgba(0,0,0,0.04)'},ticks:{font:{family:'DM Sans',size:11},color:'#9DB0A8'}}
            }
        }
    });
}
</script>
}