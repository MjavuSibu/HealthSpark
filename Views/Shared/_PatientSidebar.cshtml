<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="brand-icon">
            <svg width="18" height="18"><use href="#ic-activity" /></svg>
        </div>
        <div>
            <div class="brand-name">HealthSpark</div>
            <div class="brand-sub">My Health</div>
        </div>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-section-label">Overview</div>
        <a class="nav-item @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")"
           href="@Url.Action("Dashboard", "Patient")">
            <svg width="15" height="15"><use href="#ic-dashboard" /></svg> Dashboard
        </a>

        <div class="nav-section-label">My Health</div>
        <a class="nav-item @(ViewData["ActivePage"]?.ToString() == "Vitals" ? "active" : "")"
           href="@Url.Action("Vitals", "Patient")">
            <svg width="15" height="15"><use href="#ic-heart-pulse" /></svg> Vitals
        </a>
        <a class="nav-item @(ViewData["ActivePage"]?.ToString() == "Symptoms" ? "active" : "")"
           href="@Url.Action("Symptoms", "Patient")">
            <svg width="15" height="15"><use href="#ic-clipboard" /></svg> Symptoms
        </a>

        <div class="nav-section-label">Care</div>
        <a class="nav-item @(ViewData["ActivePage"]?.ToString() == "Appointments" ? "active" : "")"
           href="@Url.Action("Appointments", "Patient")">
            <svg width="15" height="15"><use href="#ic-calendar" /></svg> Appointments
        </a>
        <a class="nav-item @(ViewData["ActivePage"]?.ToString() == "Doctor" ? "active" : "")"
           href="@Url.Action("DoctorNotes", "Patient")">
            <svg width="15" height="15"><use href="#ic-stethoscope" /></svg> My Doctor
        </a>

        <div class="nav-section-label">Account</div>
        <a class="nav-item @(ViewData["ActivePage"]?.ToString() == "Profile" ? "active" : "")"
           href="@Url.Action("Profile", "Patient")">
            <svg width="15" height="15"><use href="#ic-user" /></svg> My Profile
        </a>
    </nav>

    <!-- ── Emergency Contacts ──────────────────────── -->
    <div class="emergency-panel">
        <div class="emergency-label">Emergency Contacts</div>

        <div class="emergency-row">
            <div class="emergency-icon-wrap">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07
                             A19.5 19.5 0 0 1 4.95 12a19.79 19.79 0 0 1-3.07-8.67
                             A2 2 0 0 1 3.88 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81
                             a2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27
                             a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7
                             A2 2 0 0 1 22 16.92z" />
                </svg>
            </div>
            <div>
                <div class="emergency-name">Ambulance (EMS)</div>
                <a href="tel:10177" class="emergency-number">10177</a>
            </div>
        </div>

        <div class="emergency-row">
            <div class="emergency-icon-wrap">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07
                             A19.5 19.5 0 0 1 4.95 12a19.79 19.79 0 0 1-3.07-8.67
                             A2 2 0 0 1 3.88 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81
                             a2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27
                             a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7
                             A2 2 0 0 1 22 16.92z" />
                </svg>
            </div>
            <div>
                <div class="emergency-name">Police</div>
                <a href="tel:10111" class="emergency-number">10111</a>
            </div>
        </div>

        <div class="emergency-row">
            <div class="emergency-icon-wrap">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                </svg>
            </div>
            <div>
                <div class="emergency-name">Netcare 911</div>
                <a href="tel:0824446911" class="emergency-number">082 444 6911</a>
            </div>
        </div>

    </div>

    <div class="sidebar-footer">
        <div class="admin-badge">
            <div class="admin-avatar">
                @{
                    var sidebarName = ViewData["CurrentUserName"]?.ToString() ?? "";
                    @(sidebarName.Length >= 2 ? sidebarName[..2].ToUpper() : sidebarName.ToUpper())
                }
            </div>
            <div>
                <div class="admin-name">@ViewData["CurrentUserName"]</div>
                <div class="admin-role">Patient</div>
            </div>
            <button onclick="openLogoutModal()"
                    style="margin-left:auto;background:none;border:none;
                           cursor:pointer;padding:4px;display:flex;align-items:center;
                           color:var(--slate-muted);transition:color 0.15s;"
                    onmouseenter="this.style.color='var(--critical)'"
                    onmouseleave="this.style.color='var(--slate-muted)'">
                <svg width="15" height="15"><use href="#ic-logout" /></svg>
            </button>
        </div>
    </div>
</aside>